# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://postgres:password@localhost:5434/localdb?schema=public"
PORT=3000

# Secret used to sign login tokens. Use a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left unset, the server generates a random secret at startup (sessions reset on restart).
JWT_SECRET="replace-with-a-long-random-string"
