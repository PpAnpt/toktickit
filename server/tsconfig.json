{
  // Type-checking config for the CommonJS Express server (run with tsx; `npx tsc --noEmit` to check)
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "prisma", "prisma.config.ts"]
}
